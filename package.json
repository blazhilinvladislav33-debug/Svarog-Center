{
  "name": "svarog-center",
  "version": "3.0.1",
  "description": "SVAROG Command Center - Complete admin dashboard for e-commerce",
  "main": "main.js",
  "homepage": "./",
  "author": "SVAROG Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron --enable-logging .",
    "build": "npm run build:win && npm run build:mac",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "dist:win": "electron-builder --win -p always",
    "dist:mac": "electron-builder --mac -p always",
    "dist:linux": "electron-builder --linux -p always",
    "pack": "electron-builder --dir",
    "prerelease": "npm run build",
    "release": "electron-builder -p always",
    "publish": "electron-builder -p always",
    "firebase:deploy": "firebase deploy --only functions,firestore:rules",
    "firebase:emulate": "firebase emulators:start --only firestore,functions",
    "firebase:logs": "firebase functions:log",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "clean": "rm -rf dist out node_modules package-lock.json"
  },
  "dependencies": {
    "electron-updater": "^7.0.0",
    "firebase": "^10.0.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.6.4",
    "firebase-tools": "^13.0.0",
    "jest": "^29.7.0",
    "eslint": "^8.51.0"
  },
  "build": {
    "appId": "com.svarog.commander",
    "productName": "SVAROG Command Center",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "admin.html",
      "auth.html",
      "styles.css",
      "constants.js",
      "firebase-config.js",
      "package.json",
      "build/**/*",
      "node_modules/**/*"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "certificateFile": null,
      "certificatePassword": null,
      "signingHashAlgorithms": [
        "sha256"
      ],
      "sign": null,
      "signAndEditExecutable": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SVAROG Command Center"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business",
      "identity": null,
      "artifactName": "${productName}-${version}.${ext}"
    },
    "dmg": {
      "contents": [
        {
          "x": 110,
          "y": 150,
          "type": "file"
        },
        {
          "x": 240,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Business;Finance",
      "artifactName": "${productName}-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "YOUR_GITHUB_USERNAME",
        "repo": "svarog-center-v3",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_GITHUB_USERNAME/svarog-center-v3.git"
  },
  "bugs": {
    "url": "https://github.com/YOUR_GITHUB_USERNAME/svarog-center-v3/issues"
  }
}
