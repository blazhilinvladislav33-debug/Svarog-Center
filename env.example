# ============================================================
# SVAROG Command Center v3.0.0 - Environment Variables
# ============================================================
# Copy this file to .env and fill in with your actual values
# ============================================================

# ============================================================
# FIREBASE CONFIGURATION
# ============================================================
FIREBASE_API_KEY=YOUR_API_KEY
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_APP_ID=your-app-id
FIREBASE_REGION=europe-west1

# ============================================================
# PAYMENT METHODS
# ============================================================

# Monobank
MONOBANK_API_KEY=your-monobank-api-key
MONOBANK_X_TOKEN=your-monobank-x-token
MONOBANK_WEBHOOK_SECRET=your-webhook-secret

# LiqPay
LIQPAY_MERCHANT_ID=your-merchant-id
LIQPAY_PUBLIC_KEY=your-public-key
LIQPAY_PRIVATE_KEY=your-private-key

# ============================================================
# EMAIL SERVICE - MAILGUN
# ============================================================
MAILGUN_DOMAIN=mg.example.com
MAILGUN_API_KEY=key-xxxxxxxx
MAILGUN_FROM_EMAIL=no-reply@example.com
MAILGUN_FROM_NAME=SVAROG Command Center

# ============================================================
# SMS SERVICE - TWILIO
# ============================================================
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================================
# DELIVERY SERVICE - NOVA POSHTA
# ============================================================
NOVAPOSHTA_API_KEY=your-api-key
NOVAPOSHTA_API_URL=https://api.novaposhta.ua/v2.0/

# ============================================================
# BACKUP SERVICES
# ============================================================

# Google Drive
GOOGLE_DRIVE_FOLDER_ID=your-folder-id
GOOGLE_DRIVE_API_KEY=your-api-key
GOOGLE_SERVICE_ACCOUNT=your-service-account-json

# AWS S3
AWS_S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=eu-west-1

# Dropbox
DROPBOX_ACCESS_TOKEN=sl.your-token
DROPBOX_FOLDER_PATH=/SVAROG/backups

# ============================================================
# TELEGRAM BOT
# ============================================================
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_ADMIN_CHAT_ID=-1001234567890
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook

# ============================================================
# APPLICATION SETTINGS
# ============================================================
NODE_ENV=production
APP_VERSION=3.0.0
LOG_LEVEL=info
DEBUG=false

# ============================================================
# GITHUB (for auto-building)
# ============================================================
GH_TOKEN=ghp_xxxxx
GH_OWNER=your-github-username
GH_REPO=svarog-center-v3

# ============================================================
# ANALYTICS & MONITORING
# ============================================================
SENTRY_DSN=your-sentry-dsn
ANALYTICS_ENABLED=true

# ============================================================
# SECURITY
# ============================================================
ENCRYPTION_KEY=your-32-character-encryption-key-here!
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60000

# ============================================================
# DATABASE SETTINGS
# ============================================================
FIRESTORE_EMULATOR_HOST=localhost:8080
USE_EMULATOR=false

# ============================================================
# NOTIFICATION SETTINGS
# ============================================================
NOTIFICATION_ENABLED=true
NOTIFICATION_BATCH_SIZE=100
NOTIFICATION_BATCH_DELAY=5000

# ============================================================
# BACKUP SETTINGS
# ============================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=90

# ============================================================
# IMPORTANT NOTES
# ============================================================
# 1. Never commit .env to git
# 2. Add .env to .gitignore
# 3. Keep API keys secure
# 4. Rotate keys regularly
# 5. Use strong passwords for accounts
# 6. Enable 2FA on all accounts
# 7. Monitor usage and costs
