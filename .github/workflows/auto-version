name: Auto Version & Release

on:
  push:
    branches:
      - main
      - master
    paths:
      - 'admin.html'
      - 'main.js'
      - 'bot.py'
      - 'functions/**'
      - 'package.json'

jobs:
  version-and-release:
    runs-on: ubuntu-latest
    permissions:
      contents: write

    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          token: ${{ secrets.GITHUB_TOKEN }}

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '18'

      - name: Configure Git
        run: |
          git config --local user.email "action@github.com"
          git config --local user.name "GitHub Action"

      - name: Bump version (patch)
        run: npm version patch --no-git-tag-version
        continue-on-error: true

      - name: Get new version
        id: version
        run: echo "VERSION=$(node -pe \"require('./package.json').version\")" >> $GITHUB_OUTPUT

      - name: Commit version bump
        run: |
          git add package.json package-lock.json
          git commit -m "chore: bump version to ${{ steps.version.outputs.VERSION }}" || true

      - name: Push changes
        run: |
          git push origin HEAD:${{ github.ref }} || true

      - name: Create Release
        uses: actions/create-release@v1
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        with:
          tag_name: v${{ steps.version.outputs.VERSION }}
          release_name: Release ${{ steps.version.outputs.VERSION }}
          body: |
            ## 🎉 SVAROG Command Center v${{ steps.version.outputs.VERSION }}

            ### ✨ Features
            - Telegram bot integration
            - Automatic order notifications
            - Admin dashboard enhancements

            ### 📦 Changes
            - Auto-bumped to this version

            [View all changes](https://github.com/${{ github.repository }}/commits/v${{ steps.version.outputs.VERSION }})
          draft: false
          prerelease: false

      - name: Notify on success
        run: echo "✅ Version ${{ steps.version.outputs.VERSION }} released!"
